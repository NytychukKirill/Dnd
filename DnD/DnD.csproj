<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="Supabase" Version="8.13.0" />
      <PackageReference Include="Supabase.Extensions.DependencyInjection" Version="8.13.0" />
      <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    </ItemGroup>

</Project>
